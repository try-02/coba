name: Android CI Tests

on:
  workflow_dispatch:

# Membatalkan tes lama yang masih berjalan jika ada push kode baru (menghemat kuota)
concurrency:
  group: ci-test-${{ github.ref }}
  cancel-in-progress: true

defaults:
  run:
    working-directory: ./coba

jobs:
  test:
    name: Run Unit & UI Tests
    runs-on: ubuntu-latest # Menggunakan Ubuntu seperti tes lamamu yang berhasil

    steps:
      - name: Checkout project code
        uses: actions/checkout@v6

      - name: Set up JDK 17
        uses: actions/setup-java@v5
        with:
          java-version: '17' 
          distribution: 'temurin'
          cache: gradle

      # 1. Memberikan izin eksekusi Gradle
      - name: Make gradlew executable
        run: chmod +x ./gradlew

      # 2. Melakukan Gradle Sync & Download Dependency Awal
      - name: Perform Gradle Sync
        run: ./gradlew help --parallel --build-cache

      # 3. Menjalankan Unit Test (ShiftSummaryTest)
      # Menambahkan --parallel dan --build-cache untuk mempercepat proses build
      - name: Run Pure Unit Tests
        run: ./gradlew testDebugUnitTest --parallel --build-cache --stacktrace

      # 4. Mengaktifkan akselerasi perangkat keras di mesin Ubuntu
      - name: Enable KVM permissions
        run: sudo chown $USER /dev/kvm

      # 5. Menjalankan Android Instrumented Test (AccountingWalkthroughTest)
      - name: Run Android Instrumented Tests
        uses: ReactiveCircus/android-emulator-runner@v2
        with:
          api-level: 30
          target: aosp_atd 
          arch: x86_64
          disable-animations: true
          working-directory: ./coba # <-- 1. Tambahkan parameter ini agar action berjalan di folder coba/
          emulator-options: -no-window -no-snapshot -noaudio -no-boot-anim -camera-back none -camera-front none
          script: ./gradlew clean connectedDebugAndroidTest --rerun-tasks --parallel --stacktrace # <-- 2. Ubah pemanggilan menjadi ./gradlew

      # 6. Pembersihan Total Runner & Bekas Proses Build
      - name: Cleanup Runner Environment & Build Artifacts
        if: always() # Memastikan step ini SELALU berjalan (Sukses, Gagal, atau Dibatalkan)
        run: |
          echo "--- Memulai Pembersihan Runner & Bekas Build ---"
          
          # 1. Menghentikan Gradle Daemon agar RAM & CPU lega
          ./gradlew --stop || true
          
          # 2. Menghentikan ADB Server & Emulator
          adb kill-server || true
          
          # 3. Menjalankan task clean dari Gradle
          ./gradlew clean || true
          
          # 4. Hapus folder build dan .gradle secara paksa
          rm -rf build app/build .gradle || true
          
          # 5. Hapus semua file/folder yang tidak di-track oleh Git (bekas kompilasi, test report, APK temporer, dll)
          git clean -ffdx || true
          
          echo "--- Pembersihan Total Selesai ---"