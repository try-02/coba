name: Build Termux Wheels

on:
  workflow_dispatch: # Memungkinkan Anda menjalankan build secara manual lewat tombol Klik

jobs:
  build-android-wheel:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v6

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.14' # Sesuaikan dengan versi Python di Termux Anda

      - name: Install Rust and Android NDK
        run: |
          rustup target add aarch64-linux-android
          # Mengunduh Android NDK minimal untuk compiler Clang Android
          echo "Installing Android NDK..."
          sudo apt-get update && sudo apt-get install -y pyo3-pack clang

      - name: Install Build Tools
        run: |
          python -m pip install --upgrade pip
          pip install maturin setuptools wheel

      - name: Clone and Build Target Library (Jiter)
        env:
          # Memberitahu compiler untuk membangun biner khusus Android ARM64 Termux
          CARGO_BUILD_TARGET: aarch64-linux-android
        run: |
          # Mengambil source code jiter langsung dari PyPI / Git
          pip download jiter --no-binary :all:
          tar -xf jiter-*.tar.gz
          cd jiter-*
          
          # Build menggunakan maturin khusus untuk target Android
          maturin build --release --target aarch64-linux-android

      - name: Upload Wheel Artifact
        uses: actions/upload-artifact@v4
        with:
          name: jiter-android-wheel
          path: jiter-*/target/wheels/*.whl
