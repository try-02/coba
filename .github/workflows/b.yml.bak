name: Build Termux Wheels (Rust/Maturin)

on:
  workflow_dispatch:

jobs:
  build-android-wheels:
    name: Build ${{ matrix.package }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        package: 
          - "jiter"
          - "pydantic-core==2.46.4"

    steps:
      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Setup Zig (Linker untuk Termux/Android)
        uses: goto-bus-stop/setup-zig@v2

      - name: Install Build Dependencies
        run: pip install maturin build typing_extensions

      - name: Download & Extract Source Code
        id: extract
        run: |
          pip download --no-binary :all: --no-deps ${{ matrix.package }}
          
          file=$(ls | grep -E '\.(tar\.gz|zip)$' | head -n 1)
          if [[ $file == *.zip ]]; then unzip "$file"; else tar -xzf "$file"; fi
          rm "$file"
          
          folder_name=$(find . -maxdepth 1 -type d ! -name "." | head -n 1)
          echo "src_dir=$folder_name" >> $GITHUB_OUTPUT

      - name: Build Wheel using Maturin Action
        uses: PyO3/maturin-action@v1
        env:
          # 1. Matikan pendeteksian Android NDK lokal agar beralih penuh ke ZIG bawaan maturin
          ANDROID_NDK_ROOT: ""
          ANDROID_NDK_HOME: ""
          
          # 2. Beritahu PyO3 bahwa ini adalah modul ekstensi distributor
          PYO3_BUILD_EXTENSION_MODULE: "1"
          
          # 3. PERBAIKAN PYDANTIC-CORE: Paksa kompatibilitas ABI ke depan untuk membungkam error versi Python
          PYO3_USE_ABI3_FORWARD_COMPATIBILITY: "1"
          
          # 4. Bendera tambahan untuk mengabaikan simbol eksternal yang belum terdefinisi pada fase kompilasi
          RUSTFLAGS: "-C link-arg=-Wl,--unresolved-symbols=ignore-all"
        with:
          working-directory: ${{ steps.extract.outputs.src_dir }}
          target: aarch64-linux-android
          manylinux: off
          command: build
          args: --release --zig --out ../final_wheels -i python3.11


      - name: Upload Wheel Artifact
        uses: actions/upload-artifact@v4
        with:
          name: termux-wheel-${{ matrix.package }}
          path: final_wheels/*.whl
