name: Build Termux Wheels

on:
  workflow_dispatch: # Tombol manual di tab Actions

jobs:
  build-android-wheel:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v6

      - name: Download Jiter Source
        run: |
          python -m pip install --upgrade pip
          # Mengunduh source code jiter versi terbaru dari PyPI
          pip download jiter --no-binary :all:
          tar -xf jiter-*.tar.gz
          # Pindahkan isi folder jiter ke root direktori kerja agar mudah dibaca maturin
          mv jiter-*/* .

      - name: Build Wheel using Maturin Action
        uses: PyO3/maturin-action@v1
        with:
          # Target diganti ke linux biasa karena Termux berjalan di atas kernel Linux ARM64
          target: aarch64
          command: build
          args: --release --interpreter python3.14

      - name: Upload Wheel Artifact
        uses: actions/upload-artifact@v4
        with:
          name: jiter-android-wheel
          path: target/wheels/*.whl
