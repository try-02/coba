name: Android Release Build coba1

on:
  workflow_dispatch:

defaults:
  run:
    working-directory: ./coba3

jobs:
  build:
    name: Build Release APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v6

      - name: Set up JDK 17
        uses: actions/setup-java@v5
        with:
          java-version: '21'
          distribution: 'temurin'
          # Perbaikan: Hapus 'cache: gradle' di sini agar tidak konflik dengan action resmi Gradle

      # Setup Gradle dengan caching otomatis & Enkripsi untuk Configuration Cache 9.6.1
      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v6
        with:
          cache-provider: Enhanced
          gradle-version: wrapper
          cache-read-only: ${{ github.ref != 'refs/heads/main' }}
          add-job-summary: on-failure
          # KRUSIAL UNTUK 9.6.1: Kunci enkripsi wajib ada agar Configuration Cache tersimpan di GitHub Actions
          cache-encryption-key: ${{ secrets.GRADLE_CACHE_ENCRYPTION_KEY }}

      # Build Release APK dengan Optimasi Maksimal AGP + Gradle 9.6.1
      - name: Build APK (Optimized)
        run: |
          echo "🏗️ Building release APK with advanced R8 shrinking..."
          chmod +x ./gradlew

          # Menambahkan flag menonaktifkan task uji coba (test) saat rilis untuk hemat waktu
          ./gradlew assembleRelease \
            -x test \
            -x connectedAndroidTest \
            --parallel \
            --build-cache \
            --configuration-cache \
            --non-interactive \
            --stacktrace
        env:
          ANDROID_BUILD_NUMBER: ${{ github.run_number }}
          NO_COLOR: "1"
          GRADLE_OPTS: "-Dorg.gradle.daemon=false"
          ORG_GRADLE_PROJECT_android_native_build_output_ignore_errors: true

      # Sign APK dengan action resmi
      - name: Sign APK
        uses: r0adkll/sign-android-release@v1
        id: sign_app
        env:
          BUILD_TOOLS_VERSION: "34.0.0"
        with:
          releaseDirectory: coba3/app/build/outputs/apk/release
          signingKeyBase64: ${{ secrets.KEYSTORE_BASE64 }}
          alias: ${{ secrets.KEY_ALIAS }}
          keyStorePassword: ${{ secrets.KEYSTORE_PASSWORD }}
          keyPassword: ${{ secrets.KEY_PASSWORD }}

      # Upload signed APK
      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: pos-offline-release-signed-apk
          path: |
            ${{steps.sign_app.outputs.signedReleaseFile}}
            coba3/app/**/*.json
          retention-days: 1
          if-no-files-found: error

      # Perbaikan: SEGERA HAPUS STEP "Cleanup Runner Environment" versi lama Anda di sini.
      # Menjalankan `./gradlew clean` atau `rm -rf .gradle` di akhir step sebelum upload cache selesai 
      # akan menghapus seluruh data kompilasi yang seharusnya di-cache untuk build berikutnya!
#
#      - name: Cleanup Runner Environment & Build Artifacts
#        if: always() # Memastikan step ini SELALU berjalan (Sukses, Gagal, atau Dibatalkan)
#        run: |
#          echo "--- Memulai Pembersihan Runner & Bekas Build ---"
#          
#          # 1. Menghentikan Gradle Daemon agar RAM & CPU lega
#          ./gradlew --stop || true
#          
#          # 3. Menjalankan task clean dari Gradle
#          ./gradlew clean || true
#          
#          # 4. Hapus folder build dan .gradle secara paksa
#          rm -rf build app/build .gradle || true
#          
#          # 5. Hapus semua file/folder yang tidak di-track oleh Git (bekas kompilasi, test report, APK temporer, dll)
#          git clean -ffdx || true
#          
 #         echo "--- Pembersihan Total Selesai ---"